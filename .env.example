# Environment Variables Template for DataDialogue

# Google AI Studio / Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Tavily Search API Key (Required for web search tool)
TAVILY_API_KEY=your_tavily_api_key_here

# ---------------------------------------------------------------------------
# LangSmith Tracing & Monitoring
# ---------------------------------------------------------------------------
# Get your API key from: https://smith.langchain.com/settings
# Enable tracing to see detailed execution logs, cost tracking, and performance metrics

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=DataDialogue
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application Settings
DATA_DIR=data
DOCS_DIR=data/documents
INDEX_DIR=data/index
SQLITE_DB_PATH=data/chinook.db
CHECKPOINTER_DB_PATH=data/checkpointer.db

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------

# PostgreSQL — only needed if using pgvector or Postgres memory (optional)
USE_PGVECTOR=false
USE_POSTGRES_MEMORY=false

# Hybrid search: semantic (vector) + BM25 (keyword) fused via Reciprocal Rank Fusion
# Better recall for exact names, IDs, codes, and numbers
USE_HYBRID_SEARCH=true

# Cross-encoder reranking — re-scores every (question, chunk) pair jointly
# for higher precision. Local model, no API key or GPU required.
# Requires: pip install llama-index-postprocessor-flashrank-rerank flashrank
USE_RERANKER=true
